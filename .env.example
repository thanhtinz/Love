# Sao chép thành .env nếu muốn ghi đè cấu hình mặc định.
# Giá trị mặc định (Supabase project love-couple-app) đã nằm trong app.json > extra,
# nên app chạy được ngay cả khi không có file .env.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
