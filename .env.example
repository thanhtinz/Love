# Để trống = chế độ TÀI KHOẢN LOCAL trên máy này (đăng ký/đăng nhập chỉ dùng trên
# chính thiết bị, realtime qua BroadcastChannel cùng máy / 2 tab).
# Điền 2 dòng dưới = bật TÀI KHOẢN SUPABASE thật: mỗi người đăng ký/đăng nhập
# bằng Supabase Auth ở mọi thiết bị, dữ liệu vườn lưu theo couple trên cloud,
# 2 điện thoại khác nhau sync realtime thật. Xem mục "Tài khoản & đăng nhập" trong README.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# V4: app chi cho dung khi da cai webapp (PWA standalone) - mo bang trinh duyet
# thuong se bi chan o man hinh huong dan cai. Khi DEV LOCAL can test bang trinh
# duyet thi tao .env.local voi dong NEXT_PUBLIC_ALLOW_BROWSER=true de bo qua cong.
# TUYET DOI khong set bien nay tren Vercel/production.
NEXT_PUBLIC_ALLOW_BROWSER=
