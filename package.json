    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "simulate": "tsc --ignoreConfig --ignoreDeprecations 6.0 src/lib/tree.ts src/lib/types.ts --outDir scripts/.build --module commonjs --target es2020 --moduleResolution node10 --skipLibCheck --esModuleInterop && node scripts/simulate-core.mjs",
    "test-logic": "tsc --ignoreConfig --ignoreDeprecations 6.0 src/lib/reducer.ts src/lib/merge.ts src/lib/time.ts src/lib/maptiles.ts src/lib/widget.ts --outDir scripts/.build --module commonjs --target es2020 --moduleResolution node10 --skipLibCheck --esModuleInterop && tsc --ignoreConfig --ignoreDeprecations 6.0 src/lib/push.ts --outDir scripts/.build --module commonjs --target es2020 --moduleResolution node10 --skipLibCheck --esModuleInterop --noCheck && TZ=Asia/Saigon node scripts/test-logic.mjs",
    "lint": "expo lint",
    "icons": "node scripts/generate-icons.mjs",
    "postinstall": "node scripts/decode-art.mjs"
  },
  "private": true
}
